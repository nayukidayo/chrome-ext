{
  "manifest_version": 3,
  "name": "工具箱：代理切换 + 翻译 + 鼠标手势",
  "version": "1.10.0",
  "description": "在系统代理与直连之间快速切换；右键菜单可翻译指针所在段落，选中文本时只在悬浮气泡里翻译；按住右键划动手势可关闭、恢复、刷新、前进后退页面或在整页顶部与底部之间跳转。",
  "minimum_chrome_version": "156",
  "permissions": ["proxy", "storage", "sessions", "contextMenus"],
  "host_permissions": [
    "https://tokenhub.tencentmaas.com/*",
    "https://tokenhub.tencentmaas.cn/*",
    "https://tokenhub-intl.tencentmaas.com/*",
    "https://tokenhub-intl.tencentmaas.cn/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "工具箱",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/translate.js", "content/gesture.js"],
      "css": ["content/translate.css"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ]
}
