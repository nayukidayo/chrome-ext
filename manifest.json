{
  "manifest_version": 3,
  "name": "工具箱：代理切换 + 段落翻译 + 鼠标手势",
  "version": "1.5.0",
  "description": "在系统代理与直连之间快速切换；按住 Ctrl 点击网页段落即可翻译；按住右键划动手势可关闭、恢复、刷新页面或回到顶部。",
  "minimum_chrome_version": "156",
  "permissions": ["proxy", "storage", "sessions"],
  "host_permissions": [
    "https://tokenhub.tencentmaas.com/*",
    "https://tokenhub.tencentmaas.cn/*",
    "https://tokenhub-intl.tencentmaas.com/*",
    "https://tokenhub-intl.tencentmaas.cn/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "工具箱",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/translate.js", "content/gesture.js"],
      "css": ["content/translate.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
